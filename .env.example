# Copie para .env (local) ou cadastre como variáveis no serviço de hospedagem.

# Obrigatório: token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Opcional: ID do servidor para o /beerchess aparecer na hora (sem isso, registra em todos)
DISCORD_GUILD_ID=

# Opcional: token pessoal do Lichess (escopo challenge:write) para os desafios saírem no seu nome
LICHESS_TOKEN=

# Opcional: partidas simultâneas (o Lichess aceita até 8 streams por IP)
MAX_GAMES=6

# Opcional: minutos esperando alguém entrar no desafio criado pelo /beerchess novo
CHALLENGE_WAIT_MINUTES=120
